{
  "name": "plyleaf",
  "version": "0.0.0",
  "private": true,
  "description": "Every PDF tool you need. Actually free. No sign-up, no watermark, no upload.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "bench:fixtures": "node bench/engine/make-fixtures.ts",
    "bench:engine": "node bench/engine/run.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "comlink": "^4.4.2",
    "fflate": "0.8.2",
    "libheif-js": "1.23.5",
    "mupdf": "1.28.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@embedpdf/pdfium": "2.15.1",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.90.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
