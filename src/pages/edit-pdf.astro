---
import ToolPage from "~/layouts/ToolPage.astro";
import { EditorWorkspace } from "~/components/editor/EditorWorkspace";
---

<ToolPage
  slug="edit-pdf"
  wide
  title="Edit PDF: change text and add images, shapes and stamps online, free"
  description="Change a PDF's text, or add text, images, boxes, arrows and stamps, in your browser: choose the font, size and colour, move and resize, and download. Free, no account, no watermark, and your file is never uploaded."
  heading="Edit PDF"
  intro="Change the words already on a page, or add text, pictures, boxes, arrows and stamps, in the size and colour you want. Free, no sign-up, no watermark, and your file never leaves this device."
  steps={[
    { title: "Add your PDF", text: "Choose it, drop it anywhere on the page, or paste it." },
    { title: "Add what you need", text: "Type text, pick a picture, or drag out a box or arrow. Move it into place." },
    { title: "Download", text: "What you added is written into the pages. No account, no watermark." },
  ]}
  faqs={[
    {
      question: "Is it really free?",
      answer:
        "Yes. There is no paid plan, no daily limit and no watermark. Plyleaf can be free because your own browser does the work.",
    },
    {
      question: "Which fonts can I use?",
      answer:
        "The three standard PDF fonts: a sans serif (Helvetica), a serif (Times) and a monospace (Courier), each in bold and italic. They cover Latin, Greek and Cyrillic alphabets. The editor tells you if something you type can't be shown in them.",
    },
    {
      question: "Can the text be changed later?",
      answer:
        "Until you download, yes: click it to edit, drag it to move it, or delete it. In the downloaded PDF it's part of the page, so it looks the same in every app and stays searchable and copyable.",
    },
    {
      question: "Which images can I add?",
      answer:
        "JPG and PNG go in exactly as they are, transparency included. Other pictures your browser can open (WebP, GIF, AVIF, and HEIC on Apple devices) are converted first, and phone photos are turned the right way up.",
    },
    {
      question: "Can I change the text that's already there?",
      answer:
        "Yes: pick Edit text and click a line. The old words are taken out of the page and yours go in their place, at the same size and colour. Text in Helvetica, Times or Courier keeps its exact font; other fonts can't be reused, so the line is written in the closest standard font, and the editor says so. Scanned pages have no text to change.",
    },
    {
      question: "Which stamps are there?",
      answer:
        "Approved, Not approved, Draft, Final, Confidential, For comment and Expired, or words of your own like PAID. They're saved as standard PDF stamps, so other apps show them and can move or remove them.",
    },
    {
      question: "Does whiteout delete what's under it?",
      answer:
        "No. Whiteout covers part of a page so it can't be seen or printed, but what's underneath is still in the file and can be copied out. To remove text for good, use redaction instead.",
    },
    {
      question: "Is my PDF uploaded?",
      answer: "No. It's edited right here in your browser and never goes over the internet.",
    },
  ]}
>
  <EditorWorkspace client:load />
</ToolPage>
