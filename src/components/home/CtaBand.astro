---
import { ArrowRightIcon } from "~/components/icons";
---

<section class="px-4 pb-16 sm:px-6 md:pb-24">
  <div class="relative mx-auto flex max-w-6xl flex-col items-start gap-6 overflow-hidden rounded-[22px] bg-sticky-lavender px-6 pt-10 pb-20 sm:px-12 md:flex-row md:items-center md:justify-between md:py-12 md:pr-36">
    <h2 class="max-w-xl text-3xl sm:text-4xl">Got a PDF to fix? Start now, finish free.</h2>
    <a href="#tools" class="btn-pill relative z-10 min-h-13 shrink-0 bg-ink px-7 text-lg text-surface hover:bg-primary">
      Browse all tools <ArrowRightIcon className="size-5" />
    </a>
    <!-- Sits in the corner the content leaves free: below the button on phones, right of it on wider screens. -->
    <span
      class="absolute -right-6 -bottom-8 size-24 rotate-12 rounded-2xl bg-sticky-yellow/70"
      aria-hidden="true"
    ></span>
  </div>
</section>
