---
import Cursor from "../Cursor.astro";
import SelectionFrame from "../SelectionFrame.astro";

const pages = ["bg-surface", "bg-surface", "bg-sticky-yellow", "bg-surface", "bg-surface", "bg-sticky-lavender"];
const toolbar = [
  "M5 12h14M12 5v14",
  "M4 20l1-5L16 4l4 4L9 19z",
  "M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13",
  "M20 12a8 8 0 1 1-3-6.2M20 4v5h-5",
];
---

<section class="px-4 py-16 sm:px-6 md:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-4xl sm:text-5xl">A whole PDF workshop in one tab</h2>
      <p class="mt-4 text-lg text-ink-muted">
        Drop a file and your pages land on the board. Reorder, rotate, edit and sign, then download. No account wall at
        the end.
      </p>
    </div>

    <!-- Illustration of the workspace; the real one arrives with the first tools. -->
    <div class="relative mt-12" aria-hidden="true">
      <div class="overflow-hidden rounded-[18px] border-2 border-ink bg-surface">
        <div class="flex items-center gap-3 border-b border-line px-4 py-3">
          <div class="flex gap-1.5">
            <span class="size-3 rounded-full bg-sticky-coral"></span>
            <span class="size-3 rounded-full bg-sticky-yellow"></span>
            <span class="size-3 rounded-full bg-sticky-mint"></span>
          </div>
          <span class="truncate text-sm font-semibold">quarterly-report.pdf</span>
          <span class="hidden text-sm text-ink-muted sm:inline">· 6 pages</span>
          <span class="ml-auto rounded-pill bg-primary px-4 py-1.5 text-sm font-semibold text-on-primary">
            Download
          </span>
        </div>

        <div class="board relative flex gap-4 p-4 sm:p-8">
          <div class="flex h-fit flex-col gap-1 rounded-xl border border-line bg-surface p-1.5 shadow-sticky">
            {toolbar.map((d, i) => (
              <span class:list={["grid size-9 place-items-center rounded-lg", i === 1 && "bg-primary/10 text-primary"]}>
                <svg
                  viewBox="0 0 24 24"
                  class="size-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={d} />
                </svg>
              </span>
            ))}
          </div>

          <div class="grid flex-1 grid-cols-3 gap-3 sm:gap-5 md:grid-cols-6">
            {pages.map((bg, i) => (
              <div class="relative">
                <div
                  class:list={[
                    "aspect-[3/4] rounded-md border border-line p-[14%] shadow-sticky",
                    bg,
                    i === 2 && "rotate-2",
                  ]}
                >
                  <div class="h-1.5 w-2/3 rounded-full bg-ink/60" />
                  <div class="mt-3 space-y-1.5">
                    <div class="h-1 rounded-full bg-ink/20" />
                    <div class="h-1 rounded-full bg-ink/20" />
                    <div class="h-1 w-4/5 rounded-full bg-ink/20" />
                  </div>
                </div>
                {i === 2 && <SelectionFrame class="-inset-2 rotate-2" />}
                <span class="mt-2 block text-center text-xs font-semibold text-ink-muted">{i + 1}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <Cursor class="top-[46%] left-[58%] hidden sm:block" color="var(--primary)" />
      <div class="absolute -top-4 -right-2 size-0 -rotate-12 border-x-[10px] border-b-[16px] border-x-transparent border-b-sticky-yellow sm:-right-5"></div>
    </div>
  </div>
</section>

<style>
  .board {
    background-color: var(--surface-band);
    background-image: radial-gradient(var(--line) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
  }
</style>
