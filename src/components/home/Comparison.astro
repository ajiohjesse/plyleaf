---
/*
 * Plyleaf vs typical online PDF tools. The "typical" column summarises STRATEGY.md §1 (as reported, 2026-10).
 * Keep the claims generic and true; name no competitor here.
 */
const rows = [
  { feature: "Download without an account", us: "Always", them: "Often needs sign-up" },
  { feature: "Daily or hourly task limits", us: "None", them: "Often 1–3 tasks" },
  { feature: "Watermark on results", us: "Never", them: "On some free plans" },
  { feature: "Where your files go", us: "Nowhere: your device", them: "Uploaded to their servers" },
  { feature: "Best features (edit text, OCR, compress)", us: "Free", them: "Usually paid" },
  { feature: "Source code you can check", us: "Yes, AGPL-3.0", them: "No" },
];
---

<section class="bg-surface-band px-4 py-16 sm:px-6 md:py-24">
  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1fr_1.6fr] lg:items-start">
    <div class="relative">
      <h2 class="text-4xl sm:text-5xl lg:text-[2.75rem]">Free means free. No catch at the download button.</h2>
      <p class="mt-4 text-lg text-ink-muted">
        Most “free” PDF sites let you do the work, then ask for an account or a card. Plyleaf has no servers doing the
        work, so there's nothing to charge for.
      </p>
      <span
        class="absolute -top-6 right-6 size-8 rounded-full bg-sticky-yellow lg:right-auto lg:left-[70%]"
        aria-hidden="true"
      ></span>
    </div>

    <div class="overflow-x-auto rounded-card border border-line bg-surface">
      <table class="w-full text-left">
        <caption class="sr-only">Plyleaf compared with typical online PDF tools</caption>
        <thead>
          <tr class="border-b border-line">
            <th scope="col" class="p-3 sm:p-4 text-sm font-semibold text-ink-muted">
              <span class="sr-only">Feature</span>
            </th>
            <th scope="col" class="p-3 sm:p-4 font-display text-base font-extrabold sm:text-lg">
              Plyleaf
            </th>
            <th scope="col" class="p-3 sm:p-4 font-display text-base font-extrabold sm:text-lg text-ink-muted">
              Typical online PDF tools
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map(({ feature, us, them }) => (
            <tr class="border-b border-line last:border-0">
              <th scope="row" class="p-3 text-sm font-medium sm:p-4">
                {feature}
              </th>
              <td class="p-3 sm:p-4">
                <span class="flex items-start gap-2 text-sm font-semibold">
                  <span
                    class="grid size-6 shrink-0 place-items-center rounded-full bg-primary text-on-primary"
                    aria-hidden="true"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      class="size-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12.5l4.5 4.5L19 7.5" />
                    </svg>
                  </span>
                  {us}
                </span>
              </td>
              <td class="p-3 sm:p-4">
                <span class="flex items-start gap-2 text-sm text-ink-muted">
                  <span class="grid size-6 shrink-0 place-items-center rounded-full bg-surface-band" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      class="size-3.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3.5"
                      stroke-linecap="round"
                    >
                      <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                  </span>
                  {them}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
