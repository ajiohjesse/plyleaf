---
const promises = [
  { title: "No sign-up", detail: "Ever. Not even to download." },
  { title: "No limits", detail: "No daily quota, no file caps." },
  { title: "No upload", detail: "Files stay on your device." },
  { title: "Open source", detail: "Check every promise yourself." },
];
---

<section aria-label="Our promises" class="border-y border-line">
  <ul class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-6 px-4 py-8 sm:px-6 md:grid-cols-4">
    {promises.map(({ title, detail }) => (
      <li class="flex gap-3">
        <svg
          viewBox="0 0 24 24"
          class="mt-0.5 size-6 shrink-0 text-primary"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 12.5l5 5L20 6.5" />
        </svg>
        <span>
          <span class="block font-display text-lg leading-tight font-extrabold">{title}</span>
          <span class="text-sm text-ink-muted">{detail}</span>
        </span>
      </li>
    ))}
  </ul>
</section>
