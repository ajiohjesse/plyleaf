---
// The Plyleaf PDF logo: the folded-page mark (also public/favicon.svg) and the wordmark with its "PDF" tag (D-048).
interface Props {
  class?: string;
  /** Wordmark colour; the mark keeps its sticky colours. */
  tone?: "ink" | "light";
}
const { class: className, tone = "ink" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2", className]}>
  <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
    <!-- A page with its corner folded back: the "plyleaf" -->
    <path
      d="M7 3.5h12.5l6 6v19H7z"
      fill="var(--sticky-yellow)"
      stroke="var(--ink)"
      stroke-width="2"
      stroke-linejoin="round"
    ></path>
    <path
      d="M19.5 3.5v6h6"
      fill="var(--sticky-pink)"
      stroke="var(--ink)"
      stroke-width="2"
      stroke-linejoin="round"
    ></path>
    <path d="M11 17h10M11 22h7" stroke="var(--ink)" stroke-width="2" stroke-linecap="round"></path>
  </svg>
  <span
    class:list={[
      "flex items-center gap-1.5 font-display text-2xl leading-none font-extrabold tracking-tight",
      tone === "light" ? "text-white" : "text-ink",
    ]}
  >
    plyleaf
    <span
      class:list={[
        "rounded-md px-1.5 py-1 font-sans text-xs leading-none font-extrabold tracking-wide",
        tone === "light" ? "bg-white text-footer-bg" : "bg-primary text-on-primary",
      ]}
    >
      PDF
    </span>
  </span>
</span>
