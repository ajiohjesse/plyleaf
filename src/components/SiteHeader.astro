---
import { ArrowRightIcon, PrivacyIcon, SourceIcon, ToolsIcon } from "~/components/icons";
import Logo from "./Logo.astro";
import { site } from "~/data/site";

const link = "flex items-center gap-1.5 rounded-pill px-3 py-2 hover:bg-surface-band";
const icon = "size-[18px] shrink-0 text-ink-muted";
---

<header class="sticky top-0 z-40 border-b border-transparent bg-surface/90 backdrop-blur">
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" aria-label={`${site.name} home`} class="rounded-md">
      <Logo />
    </a>
    <ul class="flex items-center gap-1 text-[15px] font-medium sm:gap-2">
      <li class="hidden sm:block">
        <a href="/#tools" class={link}>
          <ToolsIcon className={icon} />
          Tools
        </a>
      </li>
      <li class="hidden sm:block">
        <a href="/#how-it-works" class={link}>
          <PrivacyIcon className={icon} />
          How it works
        </a>
      </li>
      <li class="hidden md:block">
        <a href={site.repoUrl} class={link}>
          <SourceIcon className={icon} />
          Source code
        </a>
      </li>
      <li>
        <a href="/#tools" class="btn-pill min-h-10 bg-primary px-5 text-on-primary hover:bg-primary-hover">
          All tools <ArrowRightIcon className="size-4" />
        </a>
      </li>
    </ul>
  </nav>
</header>
