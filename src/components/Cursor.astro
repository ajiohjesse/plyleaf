---
/** A pointer arrow, as seen on a shared whiteboard. Decorative. */
interface Props {
  class?: string;
  color?: string;
}
const { class: className, color = "var(--ink)" } = Astro.props;
---

<svg viewBox="0 0 20 22" class:list={["absolute size-6", className]} aria-hidden="true">
  <path
    d="M2 2l15 8-6.5 1.8L7.5 19z"
    fill={color}
    stroke="var(--surface)"
    stroke-width="1.5"
    stroke-linejoin="round"
  ></path>
</svg>
